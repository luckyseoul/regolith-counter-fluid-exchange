#!/usr/bin/expect -f
# Usage: NICKNITE_PASSWORD='yourpass' ./push-to-nicknite.expect
set timeout 600
set password $env(NICKNITE_PASSWORD)
if {$password eq ""} {
    puts "Set NICKNITE_PASSWORD env var"
    exit 1
}
set src "/home/nick/rcfx-clone.tar.gz"
set dest "nicknite@192.168.1.44:~/rcfx-clone.tar.gz"
spawn rsync -avz --progress -e ssh $src $dest
expect {
    "password:" { send "$password\r"; exp_continue }
    "Password:" { send "$password\r"; exp_continue }
    eof
}
catch wait result
exit [lindex $result 3]