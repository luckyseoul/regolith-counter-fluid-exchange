# Rung 2 working input for this LIGGGHTS build (sjkr2 supported)
atom_style granular
atom_modify map array
boundary p p p
newton off
communicate single vel yes
read_data data/bimodal_regolith.data
neighbor 0.0015 bin
neigh_modify delay 0 every 1 check yes
# Material properties
fix m1 all property/global youngsModulus peratomtype 1e8 2.1e11
fix m2 all property/global poissonsRatio peratomtype 0.25 0.29
fix m3 all property/global coefficientRestitution peratomtype 0.25 0.4
fix m4 all property/global coefficientFriction peratomtype 0.55 0.35
fix m5 all property/global coefficientRollingFriction peratomtype 0.08 0.03
# Cohesion using supported model in this build
fix coh all property/global cohesionEnergyDensity peratomtype 1.8e-19 0.0
# Pair style - using supported sjkr2
pair_style gran model hertz tangential history cohesion model sjkr2
pair_coeff * *
# Gravity (lunar)
fix grav all gravity 1.625 vector 0.0 0.0 -1.0
# Time integration
fix integr all nve/sphere
# Thermo
thermo 2000
thermo_style custom step atoms ke vol cpu
# Initial relaxation
run 20000
# Main production run
dump dmp all custom 5000 post/dump.rung2 id type x y z vx vy vz radius
run 150000
# Write restart
write_restart post/restart.rung2.*
