units si
atom_style sphere
boundary f f f

region box block 0 0.36 0 0.36 0 0.7 units box
create_box 1 box

pair_style gran/hooke/history 2.0e5 50 0.5 0.0 1
pair_coeff * *

fix g all gravity 1.625 vector 0.0 -1.0 0.0

region bed block 0 0.36 0 0.36 0 0.3 units box
create_atoms 1 region bed

set type 1 diameter 7e-5 density 3100

velocity all set 0.0 0.0 0.0

thermo 500
thermo_style custom step atoms ke pe

run 10000
