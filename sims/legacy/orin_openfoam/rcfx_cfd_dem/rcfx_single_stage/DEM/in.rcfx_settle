# RCFX DEM: Particle settling under lunar gravity
# Truncated Apollo PSD (>=45um), CG=5x
# ~96k particles in pseudo-2D slab

atom_style      granular
atom_modify     map array
communicate     single vel yes
boundary        f f f
newton          off
units           si
processors      * * *

region          domain block 0.0 0.30 0.0 0.01 0.0 0.60 units box
create_box      1 domain

neighbor        0.001 bin
neigh_modify    every 1 delay 0 check yes

pair_style      gran model hertz tangential history rolling_friction cdt
pair_coeff      * *

timestep        1e-5

fix             gravi all gravity 1.625 vector 0.0 0.0 -1.0

fix     m1 all property/global youngsModulus peratomtype 5e7
fix     m2 all property/global poissonsRatio peratomtype 0.25
fix     m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix     m4 all property/global coefficientFriction peratomtypepair 1 0.6
fix     m5 all property/global coefficientRollingFriction peratomtypepair 1 0.3

fix     wall_bottom all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane 0.0
fix     wall_top all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane 0.60
fix     wall_left all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 xplane 0.0
fix     wall_right all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 xplane 0.30
fix     wall_front all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 yplane 0.0
fix     wall_back all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 yplane 0.01

region          bed_region block 0.005 0.295 0.001 0.009 0.005 0.15 units box

# CG=5x templates (truncated PSD >=45um, 6 bins)
fix     pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 3100 radius constant 1.500000e-04
fix     pts2 all particletemplate/sphere 15485867 atom_type 1 density constant 3100 radius constant 2.187500e-04
fix     pts3 all particletemplate/sphere 15485871 atom_type 1 density constant 3100 radius constant 3.125000e-04
fix     pts4 all particletemplate/sphere 15485877 atom_type 1 density constant 3100 radius constant 5.000000e-04
fix     pts5 all particletemplate/sphere 15485881 atom_type 1 density constant 3100 radius constant 9.375000e-04
fix     pts6 all particletemplate/sphere 15485891 atom_type 1 density constant 3100 radius constant 1.875000e-03

fix     pdd all particledistribution/discrete 67867979 6 pts1 0.7605 pts2 0.1471 pts3 0.0757 pts4 0.0154 pts5 0.0012 pts6 0.0001

fix     ins all insert/pack seed 86028121 distributiontemplate pdd vel constant 0.0 0.0 0.0 insert_every once overlapcheck yes all_in yes volumefraction_region 0.55 region bed_region

fix     integr all nve/sphere

dump    dmp all custom 10000 post/dump_*.liggghts id type x y z vx vy vz fx fy fz radius

thermo_style    custom step atoms ke vol
thermo          1000
thermo_modify   lost warn norm no

run             100000

print "=== RCFX Rung 0: Settling complete ==="
