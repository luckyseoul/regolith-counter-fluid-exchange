LIGGGHTS (Version LIGGGHTS-PUBLIC 3.8.0, compiled 2025-12-23-22:41:38, git commit unknown)
# ============================================================
# RCFX Rung 0 — CG5 Settling Under Lunar Gravity
# ============================================================
# Pseudo-2D slab: 0.3m x 0.01m x 0.6m
# CG factor 5: particle diameters are 5× real
# Real d50 ~70um → CG5 d50 = 350um
# Particle count: ~5,000-10,000 (fits Orin easily)
#
# Apollo PSD (Carrier 2003), coarse-grained:
#   Bin 1: d=150um (CG5 of 30um)  → CG5 radius = 375um   mass frac 0.35
#   Bin 2: d=350um (CG5 of 70um)  → CG5 radius = 875um   mass frac 0.25
#   Bin 3: d=625um (CG5 of 125um) → CG5 radius = 1563um  mass frac 0.20
#   Bin 4: d=1000um (CG5 of 200um)→ CG5 radius = 2500um  mass frac 0.15
#   Bin 5: d=1875um (CG5 of 375um)→ CG5 radius = 4688um  mass frac 0.05
# ============================================================

atom_style      granular
atom_modify     map array
boundary        f f f
newton          off
units           si
communicate     single vel yes

# Domain: 0.3m x 0.01m x 0.6m
region          reg block 0.0 0.30 0.0 0.01 0.0 0.60 units box
create_box      1 reg
Created orthogonal box = (0 0 0) to (0.3 0.01 0.6)
  2 by 1 by 8 MPI processor grid

# Contact model: Hertz with rolling friction
pair_style      gran model hertz tangential history rolling_friction cdt
pair_coeff      * *

# Material properties
fix     m1 all property/global youngsModulus peratomtype 5e7
fix     m2 all property/global poissonsRatio peratomtype 0.25
fix     m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix     m4 all property/global coefficientFriction peratomtypepair 1 0.6
fix     m5 all property/global coefficientRollingFriction peratomtypepair 1 0.3

# Lunar gravity
fix     gravi all gravity 1.625 vector 0.0 0.0 -1.0

# Walls (all 6 faces, primitive)
fix     wb all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane 0.0
fix     wt all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane 0.60
fix     wl all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 xplane 0.0
fix     wr all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 xplane 0.30
fix     wf all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 yplane 0.0
fix     wk all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 yplane 0.01

# Particle templates (CG5 — 5× real diameters)
fix     pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 3100 radius constant 3.750e-04
fix     pts2 all particletemplate/sphere 15485867 atom_type 1 density constant 3100 radius constant 8.750e-04
fix     pts3 all particletemplate/sphere 32452843 atom_type 1 density constant 3100 radius constant 1.5625e-03
fix     pts4 all particletemplate/sphere 32452867 atom_type 1 density constant 3100 radius constant 2.500e-03

fix     pdd all particledistribution/discrete 67867979 4         pts1 0.37 pts2 0.26 pts3 0.21 pts4 0.16

# Insert near bottom (z=0.001 to 0.15m) to avoid floor impact catastrophe
region  bed_region block 0.005 0.295 0.001 0.009 0.001 0.15 units box

fix     ins all insert/pack seed 86028121 distributiontemplate pdd         vel constant 0.0 0.0 0.0         insert_every once overlapcheck yes all_in yes         volumefraction_region 0.30 region bed_region

fix     integr all nve/sphere

neighbor        0.002 bin
neigh_modify    every 1 delay 0 check yes

timestep        5e-5

# Output
dump    dmp all custom 5000 post/dump_*.liggghts id type x y z vx vy vz radius
restart 10000 restart1.dat restart2.dat

thermo_style    custom step atoms ke vol
thermo          1000
thermo_modify   lost error norm no

# Run 50,000 steps = 2.5 seconds sim time
# At lunar g, free fall from 0.15m takes ~0.43s
# 2.5s is plenty for full settling + energy dissipation
run             50000
