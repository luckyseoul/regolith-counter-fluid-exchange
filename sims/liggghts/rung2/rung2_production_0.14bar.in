# RCFX Rung 2 - Production validation at 0.14 bar
# Tests bimodal regolith + realistic cohesion + iron shot agitation
# Target: stable fluidization with acceptable agglomeration and entrainment

atom_style granular
atom_modify map array

boundary p p p
newton off

communicate single vel yes

read_data data/rung2_production.data

neighbor 0.002 bin
neigh_modify delay 0 every 1 check yes

# Material properties
fix m1 all property/global youngsModulus peratomtype 1.0e8 2.1e11
fix m2 all property/global poissonsRatio peratomtype 0.25 0.29
fix m3 all property/global coefficientRestitution peratomtype 0.25 0.45
fix m4 all property/global coefficientFriction peratomtype 0.55 0.35
fix m5 all property/global coefficientRollingFriction peratomtype 0.08 0.025

# JKR cohesion (only regolith-regolith)
fix coh all property/global cohesionEnergyDensity peratomtype 2.0e-19 0.0

# Pair style - Hertz + JKR cohesion
pair_style gran model hertz tangential history cohesion model jkr
pair_coeff * *

# Gravity (lunar)
fix grav all gravity 1.625 vector 0.0 0.0 -1.0

# Time integration
fix integr all nve/sphere

# Thermo
thermo 5000
thermo_style custom step atoms ke vol cpu

# Initial relaxation (important for large systems)
run 30000

# Production run
dump dmp all custom 10000 post/dump.rung2 id type x y z vx vy vz radius
run 300000

# Write restart for continuation or post-processing
write_restart post/restart.rung2.0.14bar.*