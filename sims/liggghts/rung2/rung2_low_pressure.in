# Rung 2: Bimodal PSD + Cohesion at 0.14 bar
# Tests whether iron shot agitation can break cohesive agglomerates at low pressure

atom_style granular
atom_modify map array
communicate single vel yes

boundary p p p
newton off

processors * * *

read_data data/bimodal_regolith.data   # Will create this next

neighbor 0.002 bin
neigh_modify delay 0 every 1 check yes

# Material properties
fix m1 all property/global youngsModulus peratomtype 1e8 2e11
fix m2 all property/global poissonsRatio peratomtype 0.25 0.3
fix m3 all property/global coefficientRestitution peratomtype 0.3 0.5
fix m4 all property/global coefficientFriction peratomtype 0.6 0.4
fix m5 all property/global coefficientRollingFriction peratomtype 0.1 0.05

# Cohesion (JKR)
fix coh all property/global cohesionEnergyDensity peratomtype 2.0e-19 0.0

# Pair style with cohesion
pair_style gran model hertz tangential history cohesion model jkr
pair_coeff * *

# Gravity
fix grav all gravity 1.625 vector 0.0 0.0 -1.0

# Integration
fix integr all nve/sphere

# Thermo
thermo 1000
thermo_style custom step atoms ke cpu

# Run
run 50000

# Dump
dump dmp all custom 5000 post/dump.rung2 id type x y z vx vy vz radius mass

run 100000