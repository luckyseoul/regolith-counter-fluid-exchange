# RCFX Rung 4 - Single stage representative (0.14 bar, sjkr cohesion)
# Adapted for LIGGGHTS-PUBLIC 3.8.0 full build
# Stepping stone before full 5-stage counterflow DEM

atom_style granular
atom_modify map array
boundary p p p
newton off
communicate single vel yes

read_data data/rung4_stage.data

neighbor 0.0 nsq
neigh_modify delay 0 every 1 check yes

# Material properties - 2 atom types (regolith + iron)
fix m1 all property/global youngsModulus peratomtype 1e8 2.1e11
fix m2 all property/global poissonsRatio peratomtype 0.25 0.29
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.25 0.35 0.35 0.45
fix m4 all property/global coefficientFriction peratomtypepair 2 0.55 0.45 0.45 0.35
fix m5 all property/global coefficientRollingFriction peratomtypepair 2 0.08 0.04 0.04 0.025
fix m6 all property/global cohesionEnergyDensity peratomtypepair 2 2.0e-19 0.0 0.0 0.0

# Modern granular + sjkr cohesion (the model that works in this 3.8 build)
pair_style gran model hertz tangential history cohesion sjkr
pair_coeff * *

fix grav all gravity 1.625 vector 0.0 0.0 -1.0

fix integr all nve/sphere

thermo 2000
thermo_style custom step atoms ke vol cpu

# Short relaxation
run 5000

dump dmp all custom 2000 post/dump.rung4 id type x y z vx vy vz radius mass

# Representative production run for one stage
run 50000

write_restart post/restart.rung4.*